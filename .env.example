# .env.example
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Sepolia testnet ────────────────────────────────────────
# Get a free RPC URL from https://infura.io or https://alchemy.com
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID

# Your MetaMask wallet private key (without 0x prefix)
# CAUTION: use a dedicated test wallet – never use your main wallet's key
PRIVATE_KEY=your_private_key_here

# Optional: Etherscan API key for contract verification
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Optional: enable gas cost reporting
REPORT_GAS=true
